ICORE_BASE_URL=http://localhost:10001
ICORE_SECRET=change-me-in-production
AUTH_ENABLED=true

# ── Resend 邮件服务 ──────────────────────────────────
# 从 resend.com 获取 API Key，用于发送验证码邮件
# 留空则仅打印到后端日志（开发模式）
RESEND_API_KEY=re_your_api_key_here
# 测试阶段用 onboarding@resend.dev（无需验证域名）
# 生产阶段换成自己的域名邮箱并在 Resend 控制台完成 DNS 验证
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=iCore

# Control Plane 持久化存储路径（用户、额度、组织等）
# 警告：默认 /tmp 路径在系统重启后会清空，生产环境务必改为持久化路径
CONTROL_PLANE_STORE_PATH=/tmp/icore-control-plane.json
