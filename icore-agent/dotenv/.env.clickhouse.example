# ClickHouse service and writer settings

CLICKHOUSE_IMAGE_TAG=24.8

CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_HOST_BIND=127.0.0.1
CLICKHOUSE_HOST_HTTP_PORT=18123
CLICKHOUSE_HOST_NATIVE_PORT=19000

CLICKHOUSE_DATABASE=icore_logging_db
CLICKHOUSE_LOGS_TABLE=icore_logs
CLICKHOUSE_USER=icore_logging
CLICKHOUSE_PASSWORD=<replace-with-clickhouse-password>

CLICKHOUSE_WRITER_GROUP_ID=logging-clickhouse-writer
CLICKHOUSE_WRITER_BATCH_SIZE=500
CLICKHOUSE_WRITER_FLUSH_INTERVAL=1s
CLICKHOUSE_WRITER_HTTP_TIMEOUT=5s
