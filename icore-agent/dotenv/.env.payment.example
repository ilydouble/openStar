# Payment service database bootstrap and migration settings.
# Local compose connects to the existing postgres service; this file does not
# define or start a separate PostgreSQL container.

POSTGRES_ADMIN_USER=icore_agent
POSTGRES_ADMIN_PASSWORD=change-me
POSTGRES_ADMIN_DB=icore_agent_db

PAYMENT_DB_HOST=postgres
PAYMENT_DB_PORT=5432
PAYMENT_DB_USER=icore_payment
PAYMENT_DB_PASSWORD=<replace-with-payment-db-password>
PAYMENT_DB_NAME=icore_payment_db
PAYMENT_DB_SCHEMA=payment
PAYMENT_DATABASE_URL=postgres://icore_payment:<replace-with-payment-db-password>@postgres:5432/icore_payment_db?sslmode=disable&search_path=payment

PAYMENT_SERVICE_ADDR=:8080
PAYMENT_KAFKA_BROKERS=kafka:9092
PAYMENT_KAFKA_TOPIC=payment.events.v1
PAYMENT_ORDER_TTL=30m
PAYMENT_OUTBOX_POLL_INTERVAL=2s
PAYMENT_OUTBOX_BATCH_SIZE=50
PAYMENT_CATALOG_JSON={"items":[{"plan_code":"pro","billing_period":"monthly","currency":"CNY","amount_cents":19900,"description":"Pro monthly","entitlements_version":"account-plans-v2","enabled":true},{"plan_code":"team","billing_period":"monthly","currency":"CNY","amount_cents":69900,"description":"Team monthly","entitlements_version":"account-plans-v2","enabled":true},{"plan_code":"premium","billing_period":"monthly","currency":"CNY","amount_cents":199900,"description":"Premium monthly","entitlements_version":"account-plans-v2","enabled":true},{"plan_code":"byok","billing_period":"monthly","currency":"CNY","amount_cents":6900,"description":"BYOK monthly","entitlements_version":"account-plans-v2","enabled":true}]}

WECHATPAY_APP_ID=<replace-with-wechatpay-app-id>
WECHATPAY_MCH_ID=<replace-with-wechatpay-merchant-id>
WECHATPAY_MCH_CERT_SERIAL_NO=<replace-with-merchant-certificate-serial-no>
WECHATPAY_MCH_PRIVATE_KEY_PATH=/run/secrets/wechatpay/apiclient_key.pem
WECHATPAY_API_V3_KEY=<replace-with-api-v3-key>
WECHATPAY_PUBLIC_KEY_ID=<replace-with-wechatpay-public-key-id>
WECHATPAY_PUBLIC_KEY_PATH=/run/secrets/wechatpay/wechatpay_public_key.pem
WECHATPAY_NOTIFY_URL=https://<replace-with-public-domain>/webhooks/wechatpay/native
WECHATPAY_API_HOST=
WECHATPAY_HTTP_TIMEOUT=10s
WECHATPAY_REQUIRE_PRODUCTION_HOST=false
WECHATPAY_SECRET_HOST_DIR=../../../secrets/wechatpay
