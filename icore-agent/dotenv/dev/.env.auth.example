# Auth and account settings

ICORE_BASE_URL=http://localhost:11000
ICORE_SECRET=change-me-in-production
AUTH_ENABLED=true

JWT_SECRET=<replace-with-gateway-shared-jwt-secret>
JWT_ISSUER=icore-agent
JWT_AUDIENCE=icore-gateway
JWT_TTL_SECONDS=86400

RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=iCore

CONTROL_PLANE_STORE_PATH=/tmp/icore-control-plane.json
