# LLM provider and runtime settings

MODEL_ID=zai/glm-4.7
MODEL_ID_FAST=zai/glm-4.7

MODEL_API_BASE=
MODEL_API_KEY=

ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZAI_API_KEY=your-zai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

DISABLE_THINKING=true
AGENT_MAX_TOKENS=8192
AGENT_TEMPERATURE=0.1
AGENT_MODEL_SUPPORTS_VISION=false

TIMEOUT_INTERVAL=30
MAX_RETRIES=3

NO_PROXY=localhost,127.0.0.1,::1,postgres,redis,minio,kafka,storage-service,logging-service,icore-agent,open.bigmodel.cn,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
no_proxy=localhost,127.0.0.1,::1,postgres,redis,minio,kafka,storage-service,logging-service,icore-agent,open.bigmodel.cn,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
