PI_SERVICE_PORT=11002
PI_SERVICE_URL=http://pi-service:11002

# Pi agent LLM provider
# Supported: zai, zai-coding-cn, anthropic, openai, gemini
PI_PROVIDER=zai
PI_MODEL_ID=glm-4.7
PI_MAX_TOKENS=8192

# Stable API endpoint override (only used for zai / zai-coding-cn providers)
PI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
