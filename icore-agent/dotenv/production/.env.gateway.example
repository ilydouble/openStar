# Gateway service settings

GATEWAY_ADDR=:11000
GATEWAY_PORT_BIND=11000:11000
GATEWAY_BACKEND_URL=http://icore-agent:11001
GATEWAY_PAYMENT_SERVICE_URL=http://payment-service:8080

GATEWAY_LOGGING_SERVICE_NAME=icore-gateway
GATEWAY_LOGGING_SERVICE_TIMEOUT=2s
GATEWAY_ACCESS_LOG_QUEUE_SIZE=4096

GATEWAY_TIME_ZONE=Asia/Shanghai

GATEWAY_RATE_LIMIT_KEY_PREFIX=icore-gateway:rate
GATEWAY_CLIENT_IP_RATE=20
GATEWAY_CLIENT_IP_BURST=40
GATEWAY_USER_ID_RATE=10
GATEWAY_USER_ID_BURST=20
ICORE_AGENT_RATE=10
ICORE_AGENT_BURST=20
PAYMENT_SERVICE_RATE=5
PAYMENT_SERVICE_BURST=10

GATEWAY_READ_HEADER_TIMEOUT=5s
GATEWAY_READ_TIMEOUT=30s
# SSE chat streams (Pi mode and normal mode) can run longer than 120s on
# complex requests; WriteTimeout is an absolute deadline from the start of
# the response, so a low value here kills in-flight streams mid-output.
# Raised to align with the rest of the stack (storage-service etc. tolerate
# up to 900s).
GATEWAY_WRITE_TIMEOUT=600s
GATEWAY_IDLE_TIMEOUT=60s
GATEWAY_SHUTDOWN_TIMEOUT=10s
