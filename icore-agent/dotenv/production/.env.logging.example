# Logging service settings

LOGGING_SERVICE_TOKEN=<replace-with-logging-service-token>
LOGGING_SERVICE_URL=http://logging-service:8091
LOGGING_SERVICE_TIMEOUT=2.0
LOGGING_CLIENT_DRAIN_TIMEOUT=5.0
LOGGING_CLIENT_BATCH_FLUSH_MS=100
LOGGING_CLIENT_MAX_BATCH_SIZE=64

LOGGING_CONSOLE_COLOR=true
LOGGING_BATCH_FLUSH_MS=500
LOGGING_KAFKA_REPLAY_INTERVAL=5s
LOGGING_QUEUE_SIZE=4096
LOGGING_MAX_BATCH_SIZE=512

LOGGING_KAFKA_BROKERS=kafka:9092
LOGGING_KAFKA_TOPIC=logging.events.v1
LOGGING_KAFKA_PARTITIONS=3

LOGGING_SERVICE_READ_HEADER_TIMEOUT=5s
LOGGING_SERVICE_READ_TIMEOUT=10s
LOGGING_SERVICE_WRITE_TIMEOUT=10s
LOGGING_SERVICE_IDLE_TIMEOUT=60s
LOGGING_SERVICE_SHUTDOWN_TIMEOUT=10s

LOGGING_SPOOL_FILE=/var/lib/logging-service/spool/kafka_invalid_temp_events.jsonl
LOGGING_ERROR_AUDIT_FILE=/var/lib/logging-service/archive/kafka_invalid_temp_error_audit_events.jsonl
